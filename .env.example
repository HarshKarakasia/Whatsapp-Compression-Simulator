# Copy to .env and adjust if needed. ui/app.py reads API_URL to find the
# FastAPI backend (src/api/main.py); defaults to http://127.0.0.1:8000
# (uvicorn's default) if unset -- see configs/paths.yaml for the documented
# default and why this lives in an env var rather than that file.
API_URL=http://127.0.0.1:8000
